#!/bin/sh
# live-config component: lock the live user's password so the image has no
# known default login. Runs after user-setup (0030) creates the user.
# Local autologin (console, lightdm) and passwordless sudo are unaffected.
# `rescuebot-ssh-enable` sets a password when the person wants SSH.

. /usr/lib/live/config.sh

Cmdline ()
{
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE}
	do
		case "${_PARAMETER}" in
			live-config.username=*|username=*)
				LIVE_USERNAME="${_PARAMETER#*username=}"
				;;
		esac
	done
}

Init ()
{
	if component_was_executed "rescuebot-lock-password"
	then
		exit 0
	fi

	echo -n " rescuebot-lock-password"
}

Config ()
{
	# "!" is not a valid hash, so the account has no password at all (unlike
	# `passwd -l`, which would keep the default hash behind a lock prefix).
	usermod -p '!' "${LIVE_USERNAME:-user}"

	touch /var/lib/live/config/rescuebot-lock-password
}

Cmdline
Init
Config
